<Page x:Class="TheatreDesktop.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TheatreDesktop"
      xmlns:viewmodels="clr-namespace:TheatreDesktop.ViewModel"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=viewmodels:HomePageViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Homepage">

    <Page.Content>
        <Grid x:Name="Homepage" Style="{StaticResource BackgroundStyle}">
            <Label Content="Creative Movie Theatre Name" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontSize="48" HorizontalContentAlignment="Center" Background="#FF17E0A4" BorderBrush="#FF040404" BorderThickness="5,5,5,5"/>
            <StackPanel x:Name="Menu" Margin="254,112,254,189">
                <Button x:Name="movies" Content="View Movies" Command="{Binding Path=MoviesCommand}" Margin="0,10,0,10"/>
                <Button x:Name="account" Content="View Account" Command="{Binding Path=AccountCommand}" Margin="0,10,0,10"/>
                <Button x:Name="Close" Content="Exit" Command="{Binding Path=CloseCommand}" Margin="0,10,0,10"/>
            </StackPanel>
            <TextBox x:Name="design" HorizontalAlignment="Center" Margin="0,337,0,0" TextWrapping="Wrap" Text="Graphic Design is my passion" VerticalAlignment="Top" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}"/>

        </Grid>
    </Page.Content>
</Page>
