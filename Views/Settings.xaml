<Page x:Class="TheatreDesktop.Views.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TheatreDesktop.Views"
      xmlns:viewModels="clr-namespace:TheatreDesktop.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
      Title="Settings">

    <Grid x:Name="settings" Style="{StaticResource BackgroundStyle}">
        <Label x:Name="title" Content="Settings" HorizontalAlignment="Left" Margin="50,25,0,0" VerticalAlignment="Top" FontSize="36" FontWeight="Bold"/>
        <Label x:Name="text1" Content="There are none" HorizontalAlignment="Left" Margin="50,88,0,0" VerticalAlignment="Top"/>
        <Label x:Name="text2" Content="But here's a cat" HorizontalAlignment="Left" Margin="50,119,0,0" VerticalAlignment="Top"/>
        <Image x:Name="catImage" HorizontalAlignment="Left" Height="106" Margin="50,181,0,0" VerticalAlignment="Top" Width="198" Source="/Resources/Images/cat.png" Stretch="Fill"/>
        <Button x:Name="back" Content="Back" Command="{Binding Path=BackCommand}" HorizontalAlignment="Left" Margin="50,296,0,0" VerticalAlignment="Top"/>

    </Grid>
</Page>
